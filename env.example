# ─────────────────────────────────────────────────────────────
# Account Plan Generator — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:   cp env.example .env
# 2. Fill in your key: https://console.anthropic.com/account/keys
# 3. Start the server: npm start
# ─────────────────────────────────────────────────────────────

# Your Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: change the port the server listens on (default 3000)
# PORT=3000

# Optional: directory for persistent data (reports/, research-cache/, logs/)
# Defaults to the project directory. On Render, set this to your disk's
# mount path (e.g. /data) so saved reports survive redeploys.
# DATA_DIR=/data
